# ═══════════════════════════════════════════════════════════
# QuantEdge Backend — Environment Variables
# All services below have ₹0 free tiers
# ═══════════════════════════════════════════════════════════
# Copy to .env in apps/backend/ for local dev, or set in Railway/Render

# ─── Application ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must be at least 32 characters
JWT_SECRET=your-256-bit-secret-here-minimum-32-characters-change-this

# ─── Database ─────────────────────────────────────────────
# Development (Docker):
DATABASE_URL=jdbc:postgresql://localhost:5432/quantedge
DATABASE_USERNAME=quantedge_user
DATABASE_PASSWORD=devpassword123

# Production (Neon PostgreSQL Free Tier — https://neon.tech):
# DATABASE_URL=jdbc:postgresql://ep-xxx.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=<neon-username>
# DATABASE_PASSWORD=<neon-password>

# ─── Redis ───────────────────────────────────────────────
# Development (Docker):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword123

# Production (Upstash Redis Free — https://upstash.com):
# REDIS_URL=rediss://default:password@hostname:6380

# ─── AI: Gemini Free API (₹0) ────────────────────────────
# Sign up: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day
GEMINI_API_KEY=

# OpenRouter fallback (optional, also free models available):
# OPENROUTER_API_KEY=

# ─── Market Data (All Free) ───────────────────────────────
# Finnhub: https://finnhub.io/dashboard (Free: 60 req/min)
FINNHUB_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/support/#api-key (Free: 25 req/day)
ALPHA_VANTAGE_API_KEY=

# ─── Email: Resend Free Tier (₹0) ────────────────────────
# Sign up: https://resend.com (Free: 100 emails/day, 3k/month)
RESEND_API_KEY=

# ─── File Storage: Cloudinary Free (₹0) ──────────────────
# Sign up: https://cloudinary.com (Free: 25k transformations/month)
CLOUDINARY_URL=

# ─── Error Monitoring: Sentry Free (₹0) ─────────────────
# Sign up: https://sentry.io (Free: 5k events/month)
SENTRY_DSN=

# ─── Development Only ────────────────────────────────────
EMAIL_DEV_MODE=true    # Log emails to console instead of sending
