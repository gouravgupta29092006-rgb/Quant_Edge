# QuantEdge - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file (it is already in .gitignore)

# === Database (Required) ===
# Get a free PostgreSQL at https://neon.tech
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# === JWT Secret (Required) ===
# Generate a strong 64+ char random string
# PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=your_minimum_64_char_jwt_secret_here_replace_with_random_string

# === Market Data APIs (Optional - free tiers) ===
# Finnhub: https://finnhub.io/register
FINNHUB_API_KEY=
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# === AI (Optional - free tier) ===
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Email (Optional - free tier) ===
# Resend: https://resend.com
RESEND_API_KEY=

# === Frontend URLs ===
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws